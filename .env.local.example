# Copy to .env.local and fill in. Never commit .env.local.
# One OpenRouter key covers every model in models.json (native billed counts).
OPENROUTER_API_KEY=sk-or-...
# Optional direct keys, for models.json entries with provider "anthropic" / "openai":
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# PORT=4400
